<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <PublishAot>true</PublishAot>
        <AssemblyName>ILSight</AssemblyName>
        <Product>ILSight</Product>
        <Company>builtbyzee</Company>
        <OutputType Condition="'$(_IsPublishing)' == 'true'">WinExe</OutputType>
        <ApplicationIcon>Assets\Icon\app.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Velopack" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\ZGF\ZGF.Gui.Immediate\ZGF.Gui.Immediate.csproj" />
      <ProjectReference Include="..\ZGF\ZGF.Gui.Immediate.Widgets\ZGF.Gui.Immediate.Widgets.csproj" />
      <ProjectReference Include="..\ILSight.Core\ILSight.Core.csproj" />
      <ProjectReference Include="..\ZGF\ZGF.Gui.Generator\ZGF.Gui.Generator.csproj"
                        OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <ItemGroup>
      <AdditionalFiles Include="Localization\Strings\*.json" />
      <AdditionalFiles Include="Assets\IconThemes\lucide.json" />
    </ItemGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="ILSight.App.Tests" />
    </ItemGroup>

    <ItemGroup>
      <None Remove="Assets\Fonts\**\*.ttf" />
      <EmbeddedResource Include="Assets\Fonts\**\*.ttf">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\Icon\app_icon.rgba">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\Themes\*.json" Exclude="Assets\Themes\theme.schema.json">
        <LogicalName>Themes/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\Themes\theme.schema.json">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\Themes\README.md">
        <LogicalName>themes-readme.md</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\IconThemes\*.json" Exclude="Assets\IconThemes\icon-theme.schema.json">
        <LogicalName>IconThemes/%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\IconThemes\icon-theme.schema.json">
        <LogicalName>%(Filename)%(Extension)</LogicalName>
      </EmbeddedResource>
      <EmbeddedResource Include="Assets\IconThemes\README.md">
        <LogicalName>icon-themes-readme.md</LogicalName>
      </EmbeddedResource>
      <Content Include="..\LICENSE">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>licenses\LICENSE-ILSight.txt</TargetPath>
      </Content>
      <Content Include="Assets\Fonts\**\LICENSE-*.txt">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <TargetPath>licenses\%(Filename)%(Extension)</TargetPath>
      </Content>
    </ItemGroup>

</Project>
