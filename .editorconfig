root = true

# Coding rules (docs/RULES.md) for the ILSight projects. ZGF (a submodule) keeps its own conventions, so every section
# names the ILSight folders. Each rule is a warning while the code is brought in line with it, then an error.

[{ILSight,ILSight.Core,ILSight.Tests,ILSight.App.Tests}/**.cs]

# R001: this codebase's own static services (they hold shared state and do effects). Reached through a class's port;
# RL0101 reports their use outside adapters, tests and infrastructure files, like DateTime.Now. Of ILSpy, only the types
# whose reads reach past memory as the app makes them (a resolver hook, a type system's construction, a mapped file):
# an image read whole into memory and a built type system's entities are data.
rulelab.ambient_types = ILSight.Background, ILSight.Errors, ILSight.WorkflowRunner, ILSight.Core.Processes.RunningProcesses, ILSight.Core.Diagrams.ClassDiagrams, ILSight.Core.AtomicFile, ILSight.Core.NuGetConfigs, ILSight.Core.NuGetClient, ILSight.Core.AssemblyExport, ILSight.Core.CodeFiles, ILSight.Core.PackageExtraction, ILSight.Core.PdbFiles, ILSight.Core.AssemblyListPresets, ILSight.Core.RuntimeFolders, ILSight.Core.AssemblyListing, ILSight.Core.AssemblyPackages, ILSight.Core.AssemblyResolver, ILSight.Core.DebugSymbolFiles, ILSight.Core.LoadedAssemblies, ILSight.Core.NodeDecompiler, ILSight.Core.BrowseSessions, ILSight.Core.BrowseNodes, ILSight.Core.ReferenceNodes, ILSight.Core.ModuleNodes, ILSight.Core.MetadataNodes, ILSight.Core.PackageNodes, ILSight.Core.ILSpyTree, ILSight.Core.NodeLookup, ILSight.Core.Diagrams.TypeCards, ILSight.Core.Analysis.Analyzers, ILSight.Core.Analysis.AnalyzerScope, ILSight.Core.Analysis.MethodBodies, ILSight.Core.Analysis.CustomAttributes, ILSight.Core.Comparison.ApiEntries, ILSight.Core.NodeContentLoader, ILSight.Core.AssemblySearch, ILSight.Core.Resources.ResourceNodes, ILSight.Core.NodeDefinitions, ILSight.Core.PackageContents, ICSharpCode.Decompiler.Metadata.IAssemblyResolver, ICSharpCode.Decompiler.Metadata.UniversalAssemblyResolver, ICSharpCode.Decompiler.TypeSystem.DecompilerTypeSystem, ICSharpCode.Decompiler.Metadata.WebCilFile
# R003: immediate-mode widget functions (they take ZGF's Ui) draw and return "activated" by the framework's convention.
rulelab.widget_context_types = ZGF.Gui.Immediate.Ui
# R009: libraries that read the user's data (the assemblies opened, the pictures in them). Whatever their read throws,
# cancellation asked for excepted, is that data's failure, caught around the read alone into the unit's failure case.
rulelab.untrusted_libraries = ICSharpCode.Decompiler, ICSharpCode.BamlDecompiler, PngSharp, JpegSharp, ZGF.Svg

# R007: braces and block bodies; one-liners only for getters, accessors and lambdas.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_operators = false:error
csharp_style_expression_bodied_local_functions = false:error
dotnet_diagnostic.IDE0021.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0023.severity = error
dotnet_diagnostic.IDE0024.severity = error
dotnet_diagnostic.IDE0061.severity = error
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_lambdas = true:silent
csharp_style_implicit_object_creation_when_type_is_apparent = false:silent

# R007: locals use `var` (IDE0007 only fires where `var` would infer the identical type).
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
dotnet_diagnostic.IDE0007.severity = error

# R009: `throw ex;` (CA2200); throwing Exception / SystemException / ApplicationException (CA2201).
dotnet_diagnostic.CA2200.severity = error
dotnet_diagnostic.CA2201.severity = error

# R010: pass the token you have (CA2016); call the async version inside async code (CA1849). VSTHRD200 duplicates
# RL0301; VSTHRD003 is about Visual Studio's JoinableTaskFactory.
dotnet_diagnostic.CA2016.severity = error
dotnet_diagnostic.CA1849.severity = error
# R010: no blocking wait on a task (VSTHRD002); the one allowed wait is suppressed in place with its reason.
dotnet_diagnostic.VSTHRD002.severity = error
# R010: async void only in an event handler, an edge, suppressed with its reason (VSTHRD100); the async version
# inside async code (VSTHRD103); no task left unobserved (VSTHRD110). VSTHRD001 (posting to the UI thread by hand):
# 0, and errors keep it so.
dotnet_diagnostic.VSTHRD100.severity = error
dotnet_diagnostic.VSTHRD103.severity = error
dotnet_diagnostic.VSTHRD110.severity = error
dotnet_diagnostic.VSTHRD001.severity = error
# Documentation comments: a cref names one member (CS0419, an ambiguous overload).
dotnet_diagnostic.CS0419.severity = error
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.VSTHRD003.severity = none

