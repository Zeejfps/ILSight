dotnet_diagnostic.RL0101.severity = error
dotnet_diagnostic.RL0201.severity = error
dotnet_diagnostic.RL0202.severity = error
dotnet_diagnostic.RL0203.severity = error
dotnet_diagnostic.RL0204.severity = error
