dotnet_diagnostic.RL1202.severity = error
dotnet_diagnostic.RL0102.severity = error
dotnet_diagnostic.RL0403.severity = error
dotnet_diagnostic.RL0306.severity = error
dotnet_diagnostic.RL0307.severity = error
