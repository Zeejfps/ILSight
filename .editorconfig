root = true

# Coding rules (docs/RULES.md) for the ILSight projects. ZGF (a submodule) keeps its own conventions, so every section
# names the ILSight folders. Each rule is a warning while the code is brought in line with it, then an error.

[{ILSight,ILSight.Core,ILSight.Tests,ILSight.App.Tests}/**.cs]

# R001: this codebase's own static services (they hold shared state and do effects). Reached through a class's port;
# RL0101 reports their use outside adapters, tests and infrastructure files, like DateTime.Now.
rulelab.ambient_types = ILSight.Background, ILSight.Errors, ILSight.WorkflowRunner
# R003: immediate-mode widget functions (they take ZGF's Ui) draw and return "activated" by the framework's convention.
rulelab.widget_context_types = ZGF.Gui.Immediate.Ui

# R007: braces and block bodies; one-liners only for getters, accessors and lambdas.
csharp_prefer_braces = true:error
dotnet_diagnostic.IDE0011.severity = error
csharp_style_expression_bodied_methods = false:error
csharp_style_expression_bodied_constructors = false:error
csharp_style_expression_bodied_operators = false:error
csharp_style_expression_bodied_local_functions = false:error
dotnet_diagnostic.IDE0021.severity = error
dotnet_diagnostic.IDE0022.severity = error
dotnet_diagnostic.IDE0023.severity = error
dotnet_diagnostic.IDE0024.severity = error
dotnet_diagnostic.IDE0061.severity = error
csharp_style_expression_bodied_properties = true:silent
csharp_style_expression_bodied_accessors = true:silent
csharp_style_expression_bodied_indexers = true:silent
csharp_style_expression_bodied_lambdas = true:silent
csharp_style_implicit_object_creation_when_type_is_apparent = false:silent

# R007: locals use `var` (IDE0007 only fires where `var` would infer the identical type).
csharp_style_var_for_built_in_types = true:error
csharp_style_var_when_type_is_apparent = true:error
csharp_style_var_elsewhere = true:error
dotnet_diagnostic.IDE0007.severity = error

# R009: `throw ex;` (CA2200); throwing Exception / SystemException / ApplicationException (CA2201).
dotnet_diagnostic.CA2200.severity = warning
dotnet_diagnostic.CA2201.severity = warning

# R010: pass the token you have (CA2016); call the async version inside async code (CA1849). VSTHRD200 duplicates
# RL0301; VSTHRD003 is about Visual Studio's JoinableTaskFactory.
dotnet_diagnostic.CA2016.severity = warning
dotnet_diagnostic.CA1849.severity = warning
dotnet_diagnostic.VSTHRD200.severity = none
dotnet_diagnostic.VSTHRD003.severity = none

# RuleLab checks: warnings until each rule is clean in this repo.
dotnet_diagnostic.RL0101.severity = warning
dotnet_diagnostic.RL0201.severity = warning
dotnet_diagnostic.RL0202.severity = error
dotnet_diagnostic.RL0203.severity = warning
dotnet_diagnostic.RL0301.severity = error
dotnet_diagnostic.RL0302.severity = error
dotnet_diagnostic.RL0303.severity = error
dotnet_diagnostic.RL0304.severity = error
dotnet_diagnostic.RL0305.severity = error
dotnet_diagnostic.RL0401.severity = warning
dotnet_diagnostic.RL0501.severity = warning
dotnet_diagnostic.RL0701.severity = error
dotnet_diagnostic.RL0702.severity = error
dotnet_diagnostic.RL0801.severity = warning
dotnet_diagnostic.RL0802.severity = warning
dotnet_diagnostic.RL0803.severity = warning
dotnet_diagnostic.RL0804.severity = warning
dotnet_diagnostic.RL0805.severity = warning
dotnet_diagnostic.RL0806.severity = warning
dotnet_diagnostic.RL0807.severity = error
dotnet_diagnostic.RL0901.severity = warning
dotnet_diagnostic.RL0902.severity = warning
dotnet_diagnostic.RL1001.severity = warning
dotnet_diagnostic.RL1002.severity = warning
dotnet_diagnostic.RL1201.severity = error
dotnet_diagnostic.RL1202.severity = error
dotnet_diagnostic.RL0102.severity = warning
dotnet_diagnostic.RL0403.severity = suggestion
dotnet_diagnostic.RL0306.severity = suggestion
dotnet_diagnostic.RL0307.severity = suggestion
dotnet_diagnostic.RL0103.severity = error
dotnet_diagnostic.RL0105.severity = error
dotnet_diagnostic.RL0104.severity = suggestion
dotnet_diagnostic.RL0903.severity = suggestion
dotnet_diagnostic.RL0904.severity = suggestion
dotnet_diagnostic.RL1301.severity = error
dotnet_diagnostic.RL1302.severity = error
dotnet_diagnostic.RL1303.severity = error
dotnet_diagnostic.RL1304.severity = suggestion
dotnet_diagnostic.RL1305.severity = warning
dotnet_diagnostic.RL1306.severity = suggestion
# R011's checks are suggestions while their precision is measured (RULES.md R011).
dotnet_diagnostic.RL1101.severity = suggestion
dotnet_diagnostic.RL1102.severity = suggestion

# Test code (RULES.md Scope): R001, R004 and R011 checks skip it, and test methods needn't take a token.
[{ILSight.Tests,ILSight.App.Tests}/**.cs]
rulelab.test_code = true

# The edge where the workflows the screen asks for are started (R009, R010): it catches and reports what they end
# with, and counts them as background work.
# Edges (RULES.md "Edges"): where the framework hands control to the app. Only these start work, catch everything and
# wire adapters: the workflow runner, the command dispatcher, the app the framework drives, the launcher, and the
# composition root (AppRoot).
[{ILSight/WorkflowRunner.cs,ILSight/AppCommand.cs,ILSight/AppWorkflow.cs,ILSight/Commands.cs,ILSight/ILSightApp.cs,ILSight/ILSightAppLauncher.cs,ILSight/AppRoot.cs,ILSight/AppFrames.cs,ILSight/QueuedCommands.cs}]
rulelab.infrastructure = true

# Decompiler fixtures: source the tests compile and read as input, laid out as the tests need (R013 doesn't apply).
[ILSight.Tests/Fixtures/**.cs]
rulelab.one_type_per_file = false
