# Batch Y's pass (comments, static) raises these once it has cleared them.
dotnet_diagnostic.RL0406.severity = suggestion
dotnet_diagnostic.RL1309.severity = suggestion
dotnet_diagnostic.RL1401.severity = suggestion
# R011's checks (RULES.md R011).
dotnet_diagnostic.RL1101.severity = error
dotnet_diagnostic.RL1102.severity = error
dotnet_diagnostic.RL1103.severity = error

# Test code (RULES.md Scope): R001, R004 and R011 checks skip it, and test methods needn't take a token.
[{ILSight.Tests,ILSight.App.Tests}/**.cs]
rulelab.test_code = true

# Fixtures: source the tests compile and read back as input (the decompiler's, and the app's own types the app tests
# open, such as Outline.Inner, which the folding tests look for). Test input is exempt from every rule (RULES.md
# Scope): its form is what the tests read. The other analyzers' IDs the build raises for every file are off here too
# (a bulk dotnet_analyzer_diagnostic.severity doesn't override them).
[{ILSight.Tests,ILSight.App.Tests}/Fixtures/**.cs]
rulelab.test_input = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0007.severity = none
dotnet_diagnostic.IDE0011.severity = none
dotnet_diagnostic.IDE0021.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0023.severity = none
dotnet_diagnostic.IDE0024.severity = none
dotnet_diagnostic.IDE0061.severity = none
dotnet_diagnostic.CA1849.severity = none
dotnet_diagnostic.CA2016.severity = none
dotnet_diagnostic.CA2200.severity = none
dotnet_diagnostic.CA2201.severity = none
dotnet_diagnostic.VSTHRD001.severity = none
dotnet_diagnostic.VSTHRD002.severity = none
dotnet_diagnostic.VSTHRD100.severity = none
dotnet_diagnostic.VSTHRD103.severity = none
dotnet_diagnostic.VSTHRD110.severity = none
dotnet_diagnostic.CS0419.severity = none
