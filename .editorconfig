dotnet_diagnostic.RL0105.severity = error
dotnet_diagnostic.RL0104.severity = suggestion
dotnet_diagnostic.RL0903.severity = suggestion
dotnet_diagnostic.RL0904.severity = suggestion
dotnet_diagnostic.RL1301.severity = error
dotnet_diagnostic.RL1302.severity = error
dotnet_diagnostic.RL1303.severity = error
