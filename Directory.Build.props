<Project>

    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <MinVerTagPrefix>v</MinVerTagPrefix>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>

    <!-- Coding rules (docs/RULES.md): RuleLab's checks, Microsoft's threading analyzers (R010) and the .editorconfig
         style rules (R007), on the ILSight projects only; ZGF has its own conventions. Severities: .editorconfig. -->
    <PropertyGroup Condition="$(MSBuildProjectName.StartsWith('ILSight'))">
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- R014: doc comments are compiled, so a reference to something renamed or gone fails the build (CS1574,
             CS1734, CS1572, CS0419). CS1591 and CS1573 would ask for comments that restate the code. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="$(MSBuildProjectName.StartsWith('ILSight'))">
        <Analyzer Include="$(MSBuildThisFileDirectory)build/RuleLab/RuleLab.Analyzers.dll" />
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" PrivateAssets="all"
                          IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    </ItemGroup>

</Project>
